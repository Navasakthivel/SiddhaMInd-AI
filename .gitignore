# ---------- secrets ----------
# Never commit the Firebase service account key or a filled-in .env.
.env
secrets/*
!secrets/.gitkeep
*service-account*.json
*firebase-adminsdk*.json

# ---------- java ----------
target/
*.iml

# ---------- python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---------- data ----------
# Corpus PDFs and uploads are large and often not redistributable.
uploads/*
!uploads/.gitkeep
corpus/*
!corpus/.gitkeep
# The synthetic smoke-test fixture is committed deliberately: it carries no
# licensed content, it is small, and regenerating it needs Windows GDI+ for
# Tamil shaping. Regenerate with scripts/make_test_pdf.py.
!corpus/test-sample.pdf

# ---------- node ----------
# react-app/ is a Vite + React project, so node_modules is thousands of files
# that must never be committed. The rule lives here at the root rather than in
# a per-project .gitignore, because a nested ignore file leaves with its
# project: that is exactly how this rule went missing once before, and the
# next JS tool added anywhere would have found 5,000 dependency files staged
# with nothing stopping them.
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---------- misc ----------
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.orig
*.rej

# Tesseract language packs - ~20 MB of binary model data, fetched not authored.
tessdata/

# local run logs from scripts/run.sh
.run-logs/

# Vite writes a transpiled copy of vite.config.js beside it on every dev-server
# start and does not always clean them up; three had accumulated.
vite.config.js.timestamp-*
vite.config.*.timestamp-*

# Claude Code local settings, same reasoning as .vscode/ above.
.claude/

# Playwright browser-verification output: screenshots and JSON result dumps are
# regenerated by e2e/run-*.mjs and are large.
e2e-screenshots/
react-app/e2e/results-*.json
