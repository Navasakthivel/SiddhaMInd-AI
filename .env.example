# ============================================================
#  SiddhaMind AI - copy to .env and fill in. .env is gitignored.
# ============================================================
# Project ref: xtcqdbirjwypxbhwibmh   Region: ap-northeast-2
# Passwords: Supabase dashboard > Project Settings > Database > Connection string
#
# TWO RULES FOR THE URLS BELOW, both verified the hard way:
#
# 1. QUOTE any value containing '&'. Unquoted, `set -a; . ./.env` treats '&' as
#    "run in background" and silently truncates the value at the first one -
#    JAVA_DB_URL ends up EMPTY, and the startup guard reports it as never set.
#
# 2. PERCENT-ENCODE special characters in the password: @ -> %40, # -> %23,
#    & -> %26, / -> %2F, : -> %3A, + -> %2B, % -> %25. An unencoded '@' makes the
#    URL ambiguous about where the credentials end. Both the JDBC driver and
#    asyncpg decode the escapes back.
#
# The pooler hostname prefix is aws-0 OR aws-1 depending on which cluster your
# project sits on - it is NOT derivable from the region. Copy it from the
# dashboard. The wrong one fails with:
#     FATAL: (ENOTFOUND) tenant/user postgres.<ref> not found
# which reads like a bad username but is really a wrong host.
# ============================================================

# ---------- Java runtime: TRANSACTION pooler (port 6543) ----------
# PgBouncer transaction mode. Multiplexes many web requests onto few backends.
# prepareThreshold=0 is REQUIRED - transaction mode gives each statement a
# different backend, so server-side prepared statements break.
JAVA_DB_URL="jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?user=postgres.xtcqdbirjwypxbhwibmh&password=YOUR_DB_PASSWORD&sslmode=require&prepareThreshold=0"

# ---------- Python ingestion + retrieval: SESSION connection (port 5432) ----------
# NOTE: the direct host db.<ref>.supabase.co resolves to IPv6 ONLY. If your network
# or Docker host is IPv4-only, use the SESSION POOLER host below instead - it is
# IPv4, still session-mode, and behaves the same for this workload.
#
# Session pooler (IPv4, recommended):
PYTHON_DB_URL="postgresql://postgres.xtcqdbirjwypxbhwibmh:YOUR_DB_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Direct connection (IPv6 only):
# PYTHON_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xtcqdbirjwypxbhwibmh.supabase.co:5432/postgres?sslmode=require

# ---------- Flyway migrations ----------
# MUST be a session-mode connection. Flyway takes a session-scoped
# pg_advisory_lock; through a transaction pooler the lock would be acquired and
# released on different backends and migrations could interleave.
# Defaults to PYTHON_DB_URL, rewritten to JDBC form, if left blank.
MIGRATION_DB_URL="jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?user=postgres.xtcqdbirjwypxbhwibmh&password=YOUR_DB_PASSWORD&sslmode=require"

# ---------- Service-to-service auth ----------
# Shared bearer token between siddhamind-core and siddhamind-ai.
# Generate one:  openssl rand -hex 32
INTERNAL_API_TOKEN=

# ---------- Gemini ----------
# https://aistudio.google.com/app/apikey
# Retrieval works without a key; generation does not. With it unset, /query
# retrieves and fuses, then returns 502 rather than pretending the corpus is empty.
GEMINI_API_KEY=
# PINNED, not gemini-flash-latest. The alias currently resolves to
# gemini-3.6-flash and will silently point somewhere else later - which would swap
# the model behind the citation-grounded prompt with no diff in this repo. Prompt
# adherence IS the safety property here: the model is trusted to answer only from
# the supplied passages and to never invent a dose. That behaviour must not change
# without someone choosing it.
#
# Verified callable on this project (real generateContent calls, not docs):
#   gemini-3.6-flash OK | gemini-3.5-flash OK | gemini-3.5-flash-lite OK
#   gemini-3.1-flash-lite OK
#   gemini-2.0-flash / -001 / -lite / gemini-2.5-pro -> 429 limit: 0 (no free-tier
#     allocation at all, not an exhausted daily cap - waiting never clears it)
#   gemini-2.5-flash / -lite -> 404 not callable
GEMINI_MODEL=gemini-3.6-flash
# Low: the task is to restate what the passages say, not to write.
GEMINI_TEMPERATURE=0.2
# 4096, measured not guessed. Newer flash models spend "thinking" tokens that
# count against this budget: at TOP_K=6 passages x PASSAGE_MAX_CHARS=1600, three
# identical calls used 550/718/868 reasoning tokens plus ~160 output. At 1024 the
# worst run consumed 825 - 19% headroom, and one spike returns finishReason=
# MAX_TOKENS with EMPTY text, which reaches the UI as "assistant unavailable".
# That would be a config fault wearing an outage's clothes, and Phase 6 exists to
# keep those two apart. This is a cap, not a reservation - unused headroom is free.
GEMINI_MAX_OUTPUT_TOKENS=4096

# ---------- Retrieval ----------
# Passages returned per query, and how deep each retriever is asked to go before
# fusion. Candidates must exceed TOP_K: RRF's signal is which passages BOTH
# retrievers ranked highly, and two six-row lists barely overlap.
TOP_K=6
RETRIEVAL_CANDIDATES=24

# RRF damping, from the original Cormack et al. paper. Higher values flatten the
# gap between adjacent ranks, so agreement between retrievers matters more than
# either one's confidence.
RRF_K=60

# The "not found in corpus" threshold, on cosine similarity - absolute and
# comparable across queries, unlike ts_rank or a fused RRF score. An exact
# full-text match bypasses it, which is what protects Tamil formulation names and
# verse numbers. Raise if the assistant answers what the corpus does not cover;
# lower if it refuses questions it should handle.
DENSE_SCORE_FLOOR=0.35

PASSAGE_MAX_CHARS=1600
CITATION_SNIPPET_CHARS=320

# ---------- Embeddings ----------
# bge-m3 emits 1024-dimension dense vectors, matching doc_chunks.embedding
# vector(1024). Changing to a model of different width needs an ALTER TABLE and a
# full re-index; the Python service refuses to start on a mismatch.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
# Preload the model at startup instead of on the first ingestion. Never blocks
# readiness. Set false on a small box that only serves /health.
EMBEDDING_WARMUP=true

# ---------- OCR ----------
# Pages scoring below OCR_MIN_CONFIDENCE are excluded from the index and counted
# in source_documents.skipped_pages, with the page number and reason logged.
# They are never dropped silently.
OCR_LANGUAGES=tam+eng
OCR_MIN_CONFIDENCE=45.0
OCR_DPI=300

# Binary locations. LEAVE BLANK for Docker - the image puts both on PATH.
# Set them only when running natively on Windows, where neither installer does:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   POPPLER_PATH=C:\poppler-24.08.0\Library\bin
# Verify with: GET /internal/diagnostics
TESSERACT_CMD=
POPPLER_PATH=

# ---------- Chunking ----------
# Applies only to prose with no detected verse or formulation boundary;
# structural splits ignore these.
CHUNK_SIZE=900
CHUNK_OVERLAP=150
CHUNK_MIN_CHARS=60

# ---------- seeding ----------
# Load the Siddha reference data. One-off; leave false afterwards.
SEED_ENABLED=false
SEED_FORCE=false

# ---------- paths ----------
CORPUS_DIR=./corpus
UPLOAD_DIR=./uploads

# ---------- OCR binaries (native Windows only; Docker needs none of these) ----
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe\poppler-25.07.0\Library\bin
#
# TESSDATA_DIR is exported as TESSDATA_PREFIX. winget's Tesseract install ships
# ENGLISH ONLY, and its tessdata sits under C:\Program Files where an unelevated
# process cannot add the Tamil pack - so keep the traineddata somewhere you own:
#
#   curl -L -o tessdata/tam.traineddata \
#     https://github.com/tesseract-ocr/tessdata_best/raw/main/tam.traineddata
#   copy eng.traineddata and osd.traineddata in beside it
#
# Every language in OCR_LANGUAGES must be in this one directory. Confirm with
# GET /internal/diagnostics -> "tamilPack": true. Without it, Tamil pages OCR
# through the English model and produce CONFIDENT NONSENSE - high scores on
# meaningless text, which the confidence gate cannot catch.
# TESSDATA_DIR=C:\path\to\siddhamind\tessdata
