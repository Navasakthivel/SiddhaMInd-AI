  "formulations": [
    {
      "id": "nandukkal-parpam",
      "nameTamil": "நண்டுக்கல் பற்பம்",
      "nameEnglish": "Nandukkal Parpam",
      "sfiCode": "SFI-P-017",
      "dosageForm": "Parpam",
      "sourceBook": "Siddha TERM-1 SFI Preparations",
      "pageNo": 12,
      "verseNo": "249",
      "preparationMethod": "நண்டுக்கல்லைக் கல்வத்திலிட்டு, முள்ளங்கிச் சாற்றால் மூன்று நாட்கள் அரைத்து உலர்த்தவும். பிறகு சிறுபீளைச் சாற்றால் அரைத்து வெயிலில் உலர்த்தி எடுத்து வைத்துக் கொள்ளவும். | Levigate purified crab fossil in a kalvam with radish juice for three days and dry. Re-levigate with Aerva lanata juice and sun-dry.",
      "dose": "200-400 மி.கி., இருவேளை (200-400 mg twice daily)",
      "anupanam": "நீர், இளநீர், நீர்முள்ளிக் குடிநீர்",
      "shelfLife": "3 years",
      "containsHeavyMetal": false,
      "safetyClass": "GREEN",
      "ingredients": [
        {
          "ingredientId": "crab-fossil",
          "quantity": "தேவையான அளவு",
          "sutthiNote": "Sutthi in water before levigation"
        },
        {
          "ingredientId": "radish",
          "quantity": "சாறு தேவையான அளவு",
          "sutthiNote": "Fresh juice, 3 days levigation"
        },
        {
          "ingredientId": "mountain-knotgrass",
          "quantity": "சாறு தேவையான அளவு",
          "sutthiNote": "Fresh whole-plant juice"
        }
      ],
      "indicatedDiseases": [
        {
          "diseaseId": "neerkkattu",
          "evidenceNote": "Classical indication - SFI Term-1 verse 249"
        },
        {
          "diseaseId": "kalladaippu",
          "evidenceNote": "Classical indication - SFI Term-1 verse 249"
        },
        {
          "diseaseId": "neeradaippu",
          "evidenceNote": "Classical indication - SFI Term-1 verse 249"
        }
      ],
